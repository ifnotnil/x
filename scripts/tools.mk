# require variable REPO_ROOT

.PHONY: vet
vet:
	go vet `$(GO_PACKAGES)`
	@echo ""

.PHONY: golangci-lint
golangci-lint:
	golangci-lint run --config $(REPO_ROOT)/.golangci.yml
	@echo ''

.PHONY: golangci-lint-fmt
golangci-lint-fmt:
	golangci-lint fmt --config $(REPO_ROOT)/.golangci.yml
	@echo ''

.PHONY: goimports
goimports:
	goimports -w `$(GO_FILES)`

.PHONY: goimports.display
goimports.display:
	goimports -d `$(GO_FILES)`

.PHONY: gofmt
gofmt:
	gofmt -w `$(GO_FILES)`

.PHONY: gofmt.display
gofmt.display:
	gofmt -d `$(GO_FILES)`

.PHONY: shfmt
shfmt:
	$(REPO_ROOT)/scripts/foreach-script shfmt \
		--simplify \
		--language-dialect auto \
		--case-indent \
		--indent 2 \
		--write

.PHONY: shellcheck
shellcheck:
	$(REPO_ROOT)/scripts/foreach-script shellcheck \
		--norc \
		--external-sources \
		--format=tty \
		--enable=require-variable-braces,add-default-case

.PHONY: mockery
mockery:
	@if [ -f ./.mockery.yml ]; then \
		grep --recursive --files-with-matches '// Code generated by mockery' . | grep -v 'scripts/tools.mk' | grep -v 'bin/mockery' | xargs rm || true; \
		mockery --config ./.mockery.yml; \
	else \
		echo 'skipping mockery'; \
	fi
